NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

SUPABASE_PROJECT_URL=
SUPABASE_API_KEY=
OPENSEA_API_KEY=
# Same OpenSea key, exposed to the browser for listing via @opensea/sdk (OpenSea API from the wallet). Restrict the key by domain in the OpenSea developer dashboard.
NEXT_PUBLIC_OPENSEA_API_KEY=

# GIPHY Web API key for /breadfriend. GIPHY requires browser-side requests,
# so this key is public and must be configured before building the app.
NEXT_PUBLIC_GIPHY_API_KEY=

FRWC_GRAPHQL_URL=

NEXTAUTH_URL=
NEXTAUTH_SECRET=

NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Local Forgotten Prison lab (automatically set by pnpm prison:dev).
# Never enabled by production mode; writes always target 127.0.0.1:8545.
FORGOTTEN_PRISON_LOCAL_ENABLED=0

# Live Ethereum deployment for the public bidding page. Leave empty before launch.
FORGOTTEN_PRISON_ADDRESS=
