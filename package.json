{
  "name": "house-of-wizards-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prison:local": "tsx scripts/forgotten-prison-local.ts",
    "prison:setup": "tsx scripts/setup-forgotten-prison.ts",
    "prison:dev": "FORGOTTEN_PRISON_LOCAL_ENABLED=1 next dev --webpack --hostname 127.0.0.1 --port 3000",
    "prison:test": "tsx scripts/test-forgotten-prison.ts",
    "prison:test-bidding": "tsx scripts/test-prison-bidding.ts",
    "prison:keeper-check": "tsc -p supabase/functions/prison-keeper/tsconfig.json",
    "prison:keeper-test": "node --import tsx --test supabase/tests/keeper.test.ts",
    "prison:indexer-check": "tsc -p supabase/functions/prison-indexer/tsconfig.json",
    "prison:metadata-test": "node --import tsx --test supabase/tests/metadata.test.ts",
    "guard:sync-assets": "node ./scripts/sync-guard-game-assets.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src scripts",
    "type-check": "tsc --noEmit",
    "generate:wizard-affinity": "tsx scripts/generate-wizard-affinity.ts",
    "generate:trait-rarity": "tsx scripts/generate-trait-rarity.ts",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,md}'",
    "format:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json,css,md}'",
    "structure:check": "pnpm type-check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint:fix": "eslint src scripts --fix",
    "test:e2e": "playwright test",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "perf:check": "lhci autorun"
  },
  "dependencies": {
    "@apollo/client": "4.3.8",
    "@opensea/sdk": "14.0.1",
    "@openzeppelin/merkle-tree": "1.0.8",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@rainbow-me/rainbowkit-siwe-next-auth": "0.6.0",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "@tokenbound/sdk": "0.5.5",
    "@wagmi/core": "2.22.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "ethers": "6.17.0",
    "graphql": "17.1.0",
    "gray-matter": "4.0.3",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-snowfall": "2.4.0",
    "react-tweet": "3.3.1",
    "rehype-raw": "7.0.0",
    "rehype-unwrap-images": "1.0.0",
    "remark-breaks": "4.0.0",
    "rxjs": "7.8.2",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "siwe": "3.0.0",
    "tailwind-merge": "3.7.0",
    "viem": "2.57.19",
    "wagmi": "2.19.5",
    "zod": "4.6.7",
    "@x402/core": "2.31.0",
    "@x402/evm": "2.31.0",
    "@x402/extensions": "2.31.0",
    "@x402/svm": "2.31.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwind-variants": "4.0.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.5.0"
}
